<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>나의 시작 페이지</title>
<style>
:root{
  --bg1:#eef2ff; --bg2:#fdf2f8; --text:#1e1b4b; --muted:#6b7280;
  --card:rgba(255,255,255,.75); --border:rgba(99,102,241,.2); --accent:#6366f1;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg1:#0f172a; --bg2:#1e1b4b; --text:#f1f5f9; --muted:#94a3b8;
    --card:rgba(30,41,59,.75); --border:rgba(148,163,184,.25); --accent:#818cf8;
  }
}
:root[data-theme="dark"]{
  --bg1:#0f172a; --bg2:#1e1b4b; --text:#f1f5f9; --muted:#94a3b8;
  --card:rgba(30,41,59,.75); --border:rgba(148,163,184,.25); --accent:#818cf8;
}
html{height:100%;scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{
  margin:0;min-height:100%;color:var(--text);background:var(--bg1);
  background:linear-gradient(135deg,var(--bg1),var(--bg2)) fixed;
  font-family:"Pretendard","Apple SD Gothic Neo","Malgun Gothic",system-ui,sans-serif;
  display:flex;align-items:center;justify-content:center;padding:24px;
}
main{width:100%;max-width:640px;text-align:center}
.greet{color:var(--muted);font-size:1rem;margin:0 0 8px}
.time{font-size:clamp(3.2rem,16vw,6rem);font-weight:700;letter-spacing:-.02em;line-height:1;font-variant-numeric:tabular-nums}
.time small{font-size:.35em;font-weight:500;color:var(--muted);margin-left:.2em}
.date{margin:12px 0 36px;font-size:1.15rem;color:var(--muted)}
form{display:flex;gap:8px;background:var(--card);border:1px solid var(--border);
  border-radius:999px;padding:6px;backdrop-filter:blur(8px)}
select,input,button{font:inherit;color:inherit;border:0;background:transparent;outline:0}
select{padding:0 10px;cursor:pointer;color:var(--accent);font-weight:600}
select option{color:#111}
input{flex:1;min-width:0;padding:12px 6px;font-size:1rem}
input::placeholder{color:var(--muted)}
button{background:var(--accent);color:#fff;border-radius:999px;padding:0 22px;font-weight:600;cursor:pointer}
form:focus-within{box-shadow:0 0 0 3px var(--border)}
.links{display:flex;flex-wrap:wrap;gap:10px;justify-content:center;margin-top:28px}
.links a{color:var(--text);text-decoration:none;background:var(--card);border:1px solid var(--border);
  padding:8px 16px;border-radius:999px;font-size:.9rem}
.links a:hover{border-color:var(--accent)}
</style>
</head>
<body>
<main>
  <p class="greet" id="greet"></p>
  <div class="time" id="time"></div>
  <div class="date" id="date"></div>

  <form id="f">
    <select id="engine" aria-label="검색엔진">
      <option value="https://search.naver.com/search.naver?query=">네이버</option>
      <option value="https://www.google.com/search?q=">구글</option>
      <option value="https://www.youtube.com/results?search_query=">유튜브</option>
      <option value="https://search.daum.net/search?q=">다음</option>
    </select>
    <input id="q" type="search" placeholder="검색어를 입력하세요" autocomplete="off" autofocus>
    <button type="submit">검색</button>
  </form>

  <div class="links">
    <a href="https://www.naver.com" target="_blank" rel="noopener">네이버</a>
    <a href="https://www.google.com" target="_blank" rel="noopener">구글</a>
    <a href="https://www.youtube.com" target="_blank" rel="noopener">유튜브</a>
    <a href="https://mail.google.com" target="_blank" rel="noopener">메일</a>
    <a href="https://claude.ai" target="_blank" rel="noopener">Claude</a>
  </div>
</main>

<script>
const $ = id => document.getElementById(id);
const days = ["일","월","화","수","목","금","토"];
function tick(){
  const d = new Date();
  const h = d.getHours();
  const ap = h < 12 ? "오전" : "오후";
  const h12 = h % 12 || 12;
  const p = n => String(n).padStart(2,"0");
  $("time").innerHTML = `${p(h12)}:${p(d.getMinutes())}:${p(d.getSeconds())}<small>${ap}</small>`;
  $("date").textContent = `${d.getFullYear()}년 ${d.getMonth()+1}월 ${d.getDate()}일 ${days[d.getDay()]}요일`;
  $("greet").textContent = h < 6 ? "늦은 밤이에요 🌙" : h < 12 ? "좋은 아침이에요 ☀️" : h < 18 ? "좋은 오후예요 🌤️" : "좋은 저녁이에요 🌆";
}
tick(); setInterval(tick, 1000);

try{ const s = localStorage.getItem("engine"); if(s) $("engine").value = s; }catch(e){}
$("engine").addEventListener("change", e => { try{ localStorage.setItem("engine", e.target.value); }catch(_){} });

$("f").addEventListener("submit", e => {
  e.preventDefault();
  const q = $("q").value.trim();
  if(!q) return;
  window.open($("engine").value + encodeURIComponent(q), "_blank", "noopener");
});
</script>
</body>
</html>
