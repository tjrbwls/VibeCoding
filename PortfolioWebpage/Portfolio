<section class="sec" id="s-impact-snapshot" data-section="impact-snapshot" data-prd="F-02" data-priority="P0" aria-labelledby="impact-title">
  <div class="sec-head">
    <h2 id="impact-title">지난 3년간의 성과</h2>
