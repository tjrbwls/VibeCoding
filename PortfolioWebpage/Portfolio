<section class="sec" id="s-hero" data-section="hero" data-prd="F-01" data-priority="P0" aria-labelledby="hero-title">
  <div class="sec-head">
    <span class="meta"><span class="tag">#s-hero</span><span class="tag">F-01 · P0</span></span>
    <span class="note">스크롤 없이 한 화면에 모두 노출</span>
