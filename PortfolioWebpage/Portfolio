<script type="application/ld+json">{"@context":"https://schema.org","@type":"Person","name":"[이름]","jobTitle":"신입 [직무] 개발자","url":"[사이트 주소]","sameAs":["[GitHub URL]","[LinkedIn URL]"]}</script>
<script>try{var t=localStorage.getItem("theme");if(t)document.documentElement.dataset.theme=t}catch(e){}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet">
<!-- 디자인 기준: Astra 스타일(전폭 섹션 밴드, 넓은 컨테이너, 다크 헤더)
     섹션별 톤(--hue): hero 네이비 / impact 틸 / tech-stack 바이올렛 / projects 오렌지 / case-study 블루 / experience 로즈 / contact 딥 틸 -->
<style>
:root{
  --bg:#f4f5f7; --surface:#ffffff; --line:#d9dde5; --ink:#0e131b; --text:#262e3a; --muted:#5f6a7b;
  --accent:#0b7a72; --accent-ink:#ffffff; --tint:#e0f1ef; --grid:rgba(14,19,27,.06);
  --display:"Space Grotesk","Noto Sans KR",system-ui,sans-serif;
  color-scheme:light; box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --bg:#0a0e14; --surface:#121822; --line:#263040; --ink:#f1f4f8; --text:#d3d9e3; --muted:#98a3b5;
    --accent:#4fd1c0; --accent-ink:#04201d; --tint:#10302d; --grid:rgba(255,255,255,.05); color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0a0e14; --surface:#121822; --line:#263040; --ink:#f1f4f8; --text:#d3d9e3; --muted:#98a3b5;
  --accent:#4fd1c0; --accent-ink:#04201d; --tint:#10302d; --grid:rgba(255,255,255,.05); color-scheme:dark;
}
html{scroll-padding-top:calc(env(safe-area-inset-top,0px) + 72px);scroll-behavior:smooth;overflow-x:clip}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;overflow-x:clip;background:var(--bg);color:var(--text);font-family:"Noto Sans KR",Pretendard,system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.7;-webkit-font-smoothing:antialiased}
body::before{content:"";position:fixed;inset:0 0 auto;height:env(safe-area-inset-top,0px);background:var(--bg);z-index:40}
a{color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px;border-radius:4px}
.wrap{max-width:1080px;margin:0 auto;padding:0 24px}
h1,h2,h3{margin:0;color:var(--ink);line-height:1.2;letter-spacing:-.02em}
h2{font-size:1.5rem;font-weight:700}
h3{font-size:1.05rem;font-weight:600}
p{margin:0}

/* 구조 표시용 (개발 단계 전용: .tag, .ph, .note) */
.tag{display:inline-block;font:500 .72rem/1.5 ui-monospace,SFMono-Regular,Menlo,monospace;color:var(--muted);border:1px solid var(--line);padding:0 8px;border-radius:999px;background:var(--surface)}
.note{color:var(--muted);font-size:.9rem}
.ph{border:1px dashed var(--line);border-radius:10px;padding:12px 14px;color:var(--muted);font-size:.92rem}

/* 버튼 */
.btn{display:inline-flex;align-items:center;justify-content:center;padding:12px 24px;border-radius:999px;border:1px solid var(--line);color:var(--ink);text-decoration:none;font-weight:500;transition:background .2s,border-color .2s,color .2s}
.btn:hover{border-color:var(--ink)}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.primary:hover{filter:brightness(1.08)}

/* 내비게이션 */
.site-nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:50;background:color-mix(in srgb,var(--bg) 82%,transparent);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.site-nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:64px;flex-wrap:wrap}
.site-nav ul{display:flex;align-items:center;gap:22px;list-style:none;margin:0;padding:0;flex-wrap:wrap}
.site-nav a{text-decoration:none;color:var(--muted);transition:color .2s}
.site-nav a:hover{color:var(--ink)}
.site-nav .btn{padding:8px 18px;color:var(--accent-ink)}
.logo{font-family:var(--display);font-weight:700;font-size:1.1rem;color:var(--ink)!important;letter-spacing:-.02em}

/* 섹션 공통: 좌측 제목 열 + 우측 본문 열 */
.sec{display:grid;grid-template-columns:200px minmax(0,1fr);column-gap:48px;row-gap:18px;padding:64px 0;border-top:1px solid var(--line);margin:0}
.sec>*:not(.sec-head){grid-column:2}
.sec-head{grid-column:1;grid-row:1 / span 20;align-self:start;position:sticky;top:calc(env(safe-area-inset-top,0px) + 88px);display:grid;gap:12px;justify-items:start}
.sec-head .meta{display:flex;flex-wrap:wrap;gap:6px}
@media (max-width:760px){
  .sec{display:block;padding:44px 0}
  .sec-head{position:static;margin-bottom:14px}
  .sec>*:not(.sec-head){margin-top:14px}
}

/* 개발용 섹션 맵 */
.sec.outline{display:block;margin-top:32px;padding:20px 22px;border:1px dashed var(--line);border-radius:16px}
.outline .sec-head{position:static;display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:8px}
.outline ol{margin:10px 0 0;padding-left:1.3em;display:grid;gap:4px 24px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.outline li{font-size:.92rem;color:var(--muted)}
.outline li a{color:var(--ink)}

/* 히어로 */
#s-hero{display:block;position:relative;border-top:0;padding:72px 0 80px}
#s-hero::before{content:"";position:absolute;z-index:-1;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);background-image:linear-gradient(var(--grid) 1px,transparent 1px),linear-gradient(90deg,var(--grid) 1px,transparent 1px);background-size:56px 56px;-webkit-mask-image:linear-gradient(to bottom,#000 25%,transparent);mask-image:linear-gradient(to bottom,#000 25%,transparent)}
#s-hero .sec-head{position:static;display:flex;flex-wrap:wrap;align-items:center;gap:10px 14px;margin-bottom:28px}
.hero-body{display:grid;gap:22px;justify-items:start}
.hero-body h1{font-family:var(--display);font-size:clamp(2.9rem,10vw,6.2rem);font-weight:700;letter-spacing:-.04em;line-height:1}
.hero-role{font-size:clamp(1.1rem,2.4vw,1.5rem);font-weight:500;color:var(--accent)}
.hero-body .ph{font-size:1.2rem;max-width:40ch;padding:14px 18px;color:var(--text)}
.hero-actions{display:flex;flex-wrap:wrap;gap:12px;margin-top:6px}
.hero-links{display:flex;gap:20px;flex-wrap:wrap;color:var(--muted)}
.hero-links a{text-underline-offset:4px}

/* 카드 그리드 */
.grid{display:grid;gap:16px}
.g-3{grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.card{background:var(--surface);border:1px solid var(--line);border-radius:16px;padding:22px;display:grid;gap:10px;align-content:start;transition:border-color .2s}
article.card:hover{border-color:var(--accent)}
.card a{text-underline-offset:3px}

/* 지난 3년 성과 리스트: 페이지의 핵심 요소 */
.impact-year{display:grid;grid-template-columns:110px minmax(0,1fr);gap:8px 24px;padding:26px 0;border-top:1px solid var(--line)}
.impact-year:first-child{border-top:0;padding-top:4px}
.impact-year h3{font-family:var(--display);font-size:2rem;font-weight:700;color:var(--muted);letter-spacing:-.03em;line-height:1.1}
.impact-year ul{list-style:none;margin:0;padding:0;display:grid;gap:18px}
.impact-year li{display:grid;grid-template-columns:minmax(130px,auto) minmax(0,1fr);gap:4px 24px;align-items:baseline}
.impact-metric{font-family:var(--display);font-weight:700;font-size:1.6rem;letter-spacing:-.03em;color:var(--accent);line-height:1.2}
@media (max-width:640px){.impact-year{grid-template-columns:1fr}.impact-year li{grid-template-columns:1fr}}

/* 케이스 스터디 흐름 */
.flow{margin:0;padding:0;list-style:none;counter-reset:step}
.flow li{counter-increment:step;position:relative;padding:14px 0 14px 48px;border-bottom:1px solid var(--line);color:var(--muted)}
.flow li:last-child{border-bottom:0}
.flow li::before{content:counter(step);position:absolute;left:0;top:14px;width:28px;height:28px;border-radius:50%;background:var(--tint);color:var(--accent);font-family:var(--display);font-weight:700;font-size:.85rem;display:grid;place-items:center}
.flow b{color:var(--ink)}

/* 경력 타임라인 */
.timeline{margin:0;padding:0 0 0 22px;list-style:none;border-left:1px solid var(--line);display:grid;gap:28px}
.timeline li{position:relative;display:grid;gap:4px}
.timeline li::before{content:"";position:absolute;left:-28px;top:7px;width:11px;height:11px;border-radius:50%;background:var(--bg);border:2px solid var(--accent)}

/* 고정 연락 버튼 */
.sticky-cta{position:fixed;right:20px;bottom:0;z-index:60;padding-bottom:calc(env(safe-area-inset-bottom,0px) + 20px)}
.sticky-cta .btn{box-shadow:0 10px 28px rgba(0,0,0,.22)}

footer{border-top:1px solid var(--line);padding:32px 0 120px}

/* ===== Astra 스타일 적용: 전폭 섹션 밴드 + 섹션별 색상 톤 ===== */
.wrap{max-width:1200px}
body::before{background:#0f1a3a}

/* 헤더: 히어로와 이어지는 다크 네이비 */
.site-nav{--ink:#f5f7ff;--muted:#a3afd3;--line:rgba(255,255,255,.14);--accent:#8ff0df;--accent-ink:#06201c;background:rgba(15,26,58,.9);border-bottom-color:rgba(255,255,255,.1)}
.site-nav .btn{color:var(--accent-ink)}

/* 섹션 밴드: --hue 하나로 라이트/다크 팔레트를 파생 */
.sec{
  --hue:#64748b;
  --bg:color-mix(in srgb,var(--hue) 11%,#fff);
  --surface:color-mix(in srgb,var(--hue) 3%,#fff);
  --line:color-mix(in srgb,var(--hue) 24%,#d3d8e0);
  --ink:color-mix(in srgb,var(--hue) 22%,#080c14);
  --text:color-mix(in srgb,var(--hue) 20%,#1e2531);
  --muted:color-mix(in srgb,var(--hue) 25%,#3f485a);
  --accent:color-mix(in srgb,var(--hue) 74%,#000);
  --accent-ink:#fff;
  --tint:color-mix(in srgb,var(--hue) 18%,#fff);
  background:var(--bg);box-shadow:0 0 0 100vmax var(--bg);clip-path:inset(0 -100vmax);border-top:0;
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]) .sec{
    --bg:color-mix(in srgb,var(--hue) 16%,#0a0d14);
    --surface:color-mix(in srgb,var(--hue) 24%,#0a0d14);
    --line:color-mix(in srgb,var(--hue) 30%,#232b3a);
    --ink:color-mix(in srgb,var(--hue) 10%,#f3f5f9);
    --text:color-mix(in srgb,var(--hue) 12%,#d5dae4);
    --muted:color-mix(in srgb,var(--hue) 25%,#9ba5b7);
    --accent:color-mix(in srgb,var(--hue) 62%,#fff);
    --accent-ink:#07101a;
    --tint:color-mix(in srgb,var(--hue) 30%,#0a0d14);
  }
}
:root[data-theme="dark"] .sec{
  --bg:color-mix(in srgb,var(--hue) 16%,#0a0d14);
  --surface:color-mix(in srgb,var(--hue) 24%,#0a0d14);
  --line:color-mix(in srgb,var(--hue) 30%,#232b3a);
  --ink:color-mix(in srgb,var(--hue) 10%,#f3f5f9);
  --text:color-mix(in srgb,var(--hue) 12%,#d5dae4);
  --muted:color-mix(in srgb,var(--hue) 25%,#9ba5b7);
  --accent:color-mix(in srgb,var(--hue) 62%,#fff);
  --accent-ink:#07101a;
  --tint:color-mix(in srgb,var(--hue) 30%,#0a0d14);
}

/* 섹션별 톤 */
#s-impact-snapshot{--hue:#0e8a80}
#s-tech-stack{--hue:#6a4fe0}
#s-featured-projects{--hue:#e0700f}
#s-case-study-template{--hue:#2576c8}
#s-experience-timeline{--hue:#c42a5a}

/* 히어로(네이비)와 연락처(딥 틸)는 라이트/다크 모두 어두운 톤 고정 */
#s-hero{--bg:#0f1a3a;--surface:#16244d;--line:rgba(255,255,255,.16);--ink:#f5f7ff;--text:#d5dcf2;--muted:#a3afd3;--accent:#8ff0df;--accent-ink:#06201c;--tint:#1c2f63;--grid:rgba(255,255,255,.07)}
#s-contact{--bg:#0b2a2a;--surface:#123a39;--line:rgba(255,255,255,.16);--ink:#effcfa;--text:#cfeeea;--muted:#9cc7c1;--accent:#6ee7d7;--accent-ink:#04201d;--tint:#145049}

/* 개발용 섹션 맵은 밴드 없이 */
.sec.outline{background:transparent;box-shadow:none;clip-path:none;margin-bottom:32px}

/* 푸터 */
footer{--surface:#121a2c;--line:#263040;--muted:#98a3b5;background:#080c18;box-shadow:0 0 0 100vmax #080c18;clip-path:inset(0 -100vmax);border-top:0;color:var(--muted)}

/* ===== 마무리: 접근성, 테마 토글, 개발용 요소 숨김 ===== */
.skip-link{position:fixed;left:12px;top:-60px;z-index:100;background:var(--accent);color:var(--accent-ink);padding:10px 16px;border-radius:999px;text-decoration:none;font-weight:500;transition:top .15s}
.skip-link:focus{top:calc(env(safe-area-inset-top,0px) + 10px)}
.theme-toggle{width:36px;height:36px;border-radius:999px;border:1px solid var(--line);background:transparent;color:var(--ink);font-size:1.05rem;cursor:pointer;line-height:1}
.theme-toggle:hover{border-color:var(--ink)}
.theme-toggle[hidden]{display:none}
.hero-avail{color:var(--muted);font-size:.95rem}
body:not(.dev) #s-dev-outline,body:not(.dev) .tag,body:not(.dev) .sec>.note,body:not(.dev) .sec-head .note,body:not(.dev) #s-hero .sec-head{display:none}
body:not(.dev) #s-hero{padding-top:56px}
</style>
</head>
