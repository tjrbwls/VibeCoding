<script>
(function(){
  var d=document,r=d.documentElement;
  if(new URLSearchParams(location.search).has("dev"))d.body.classList.add("dev");
  function track(n,props){try{(window.__events=window.__events||[]).push({n:n,props:props,t:Date.now()});if(window.plausible)window.plausible(n,{props:props})}catch(e){}}
  var tg=d.querySelector('[data-part="nav-theme-toggle"]');
  if(tg){
    tg.hidden=false;
    var cur=function(){return r.dataset.theme||(matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light")};
    tg.setAttribute("aria-pressed",cur()==="dark");
    tg.addEventListener("click",function(){var n=cur()==="dark"?"light":"dark";r.dataset.theme=n;tg.setAttribute("aria-pressed",n==="dark");try{localStorage.setItem("theme",n)}catch(e){}});
  }
  function copy(t,ok){
    function fb(){var x=d.createElement("textarea");x.value=t;x.style.cssText="position:fixed;opacity:0";d.body.appendChild(x);x.select();try{d.execCommand("copy");ok()}catch(e){}d.body.removeChild(x)}
    if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(ok,fb)}else{fb()}
  }
  d.addEventListener("click",function(e){
    if(e.target.closest('a[href="#"]'))e.preventDefault();
    var a=e.target.closest("[data-action]");if(!a)return;
    var card=a.closest('[data-part^="project-card"]'),act=a.dataset.action;
    track(act,card?{project:card.dataset.part}:undefined);
    if(act==="email_copy"){
      var label=a.dataset.label||(a.dataset.label=a.textContent);
      copy(a.dataset.email||"",function(){a.textContent="복사되었습니다";setTimeout(function(){a.textContent=label},1800)});
    }
  });
  var fired={};
  addEventListener("scroll",function(){
    var h=r.scrollHeight-innerHeight;if(h<=0)return;
    var pct=scrollY/h*100;
    [25,50,75,100].forEach(function(m){if(pct>=m-0.5&&!fired[m]){fired[m]=1;track("scroll_depth",{percent:m})}});
  },{passive:true});
})();
</script>
